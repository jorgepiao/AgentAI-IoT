# =============================================================================
# AgentAI IoT — Variables de Entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
# NUNCA subas el archivo .env real al repositorio.
# =============================================================================

# --- Modo de operación ---
# "simulation"  → usa prefijo sim/ (sin hardware real)
# "production"  → usa prefijo home/ (hardware físico)
MODE=simulation

# --- Servidor FastAPI ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Ollama (LLM Local) ---
# URL base del servidor Ollama (por defecto localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a utilizar (debe estar descargado en Ollama)
LLM_MODEL=llama3
# Temperatura del modelo (0.0 = determinista, 1.0 = creativo)
LLM_TEMPERATURE=0.1
# Máximo de tokens por respuesta
LLM_MAX_TOKENS=512

# --- MQTT Broker (Eclipse Mosquitto) ---
# Con Docker: MQTT_HOST=mosquitto (nombre del servicio en docker-compose)
# Sin Docker: MQTT_HOST=localhost
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60
# Credenciales (opcional, dejar vacío si no requiere autenticación)
MQTT_USERNAME=
MQTT_PASSWORD=
